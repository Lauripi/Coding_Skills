# =============================================================================
# Variant calling on human mtDNA (Blood/Cheek x PCR1/PCR2) -- Snakemake version of
# the Galaxy workflow used in the "Variant Call" assignment.
#
#   Galaxy tool            Snakemake rule            Output folder
#   ------------------     ---------------------     -------------------------
#   FastQC (raw)           fastqc_raw                01_fastqc_raw/
#   Trimmomatic            trim                      02_trimmed/
#   FastQC (trimmed)       fastqc_posttrim           03_fastqc_posttrim/
#   MultiQC                multiqc                   06_multiqc/
#   BWA-MEM (map to chrM)  bwa_index, map_sort       04_bam/<sample>.sorted.bam
#   Filter unmapped reads  (samtools view -F 4, inside map_sort)
#   RmDup                  rmdup                     04_bam/<sample>.nodup.bam
#   Qualimap BamQC         qualimap                  05_qualimap/<sample>/
#   FreeBayes              freebayes                 07_vcf/all_samples.vcf
#   IGV                    igv_report (igv-reports)  09_igv/igv_report.html
#   (manual counting)      summary  (Python)         08_summary/  tables + the MultiQC,
#                                                    Qualimap and IGV figures collected
#
# Usage (inside the conda environment, see README.md):
#   snakemake -n              # dry run: list the jobs that would be executed
#   snakemake --cores 4       # run the whole workflow
#   snakemake --cores 4 08_summary/summary.md   # run up to a given target only
# =============================================================================

import os

configfile: "config.yaml"

SAMPLES = config["samples"]
REF = config["reference"]
BWA_INDEX = [REF + ext for ext in (".amb", ".ann", ".bwt", ".pac", ".sa")]
THREADS = int(config.get("threads", 4))

# Qualimap BamQC figures used in the assignment (files in images_qualimapReport/)
QUALIMAP_PLOTS = [
    "genome_coverage_across_reference",
    "genome_mapping_quality_across_reference",
    "genome_mapping_quality_histogram",
]

if not os.path.exists(REF):
    raise FileNotFoundError(f"Reference {REF!r} not found next to the Snakefile")


# Sample names are only ever the ones listed in config.yaml
wildcard_constraints:
    sample="|".join(SAMPLES)


def read_group(wildcards):
    """@RG line for bwa mem. SM = sample name as in Galaxy/the VCF (hyphens)."""
    name = wildcards.sample.replace("_", "-")
    return rf"@RG\tID:{name}\tSM:{name}\tPL:ILLUMINA"


# -----------------------------------------------------------------------------
# Final targets
# -----------------------------------------------------------------------------
rule all:
    input:
        expand("01_fastqc_raw/{sample}_fastqc.html", sample=SAMPLES),
        expand("03_fastqc_posttrim/{sample}_posttrim_fastqc.html", sample=SAMPLES),
        "06_multiqc/multiqc_report.html",
        expand("05_qualimap/{sample}/qualimapReport.html", sample=SAMPLES),
        "07_vcf/all_samples.vcf",
        "09_igv/igv_report.html",
        "08_summary/summary.md",


# -----------------------------------------------------------------------------
# 1. Quality control of the raw reads
# -----------------------------------------------------------------------------
rule fastqc_raw:
    input:
        "{sample}.fastq",
    output:
        html="01_fastqc_raw/{sample}_fastqc.html",
        zip="01_fastqc_raw/{sample}_fastqc.zip",
    log:
        "logs/fastqc_raw/{sample}.log",
    threads: THREADS
    shell:
        "fastqc --threads {threads} --outdir 01_fastqc_raw {input} > {log} 2>&1"


# -----------------------------------------------------------------------------
# 2. Trimming (Trimmomatic, single-end) + QC of the trimmed reads
# -----------------------------------------------------------------------------
rule trim:
    input:
        "{sample}.fastq",
    output:
        "02_trimmed/{sample}_posttrim.fastq",
    params:
        phred=config["trimming"]["phred"],
        steps=config["trimming"]["steps"],
    log:
        "logs/trim/{sample}.log",
    threads: THREADS
    shell:
        "trimmomatic SE -threads {threads} -phred{params.phred} "
        "{input} {output} {params.steps} > {log} 2>&1"


rule fastqc_posttrim:
    input:
        "02_trimmed/{sample}_posttrim.fastq",
    output:
        html="03_fastqc_posttrim/{sample}_posttrim_fastqc.html",
        zip="03_fastqc_posttrim/{sample}_posttrim_fastqc.zip",
    log:
        "logs/fastqc_posttrim/{sample}.log",
    threads: THREADS
    shell:
        "fastqc --threads {threads} --outdir 03_fastqc_posttrim {input} > {log} 2>&1"


# -----------------------------------------------------------------------------
# 3. MultiQC: one report for raw + trimmed FastQC results
# -----------------------------------------------------------------------------
rule multiqc:
    input:
        expand("01_fastqc_raw/{sample}_fastqc.zip", sample=SAMPLES),
        expand("03_fastqc_posttrim/{sample}_posttrim_fastqc.zip", sample=SAMPLES),
    output:
        html="06_multiqc/multiqc_report.html",
        table="06_multiqc/multiqc_data/multiqc_fastqc.txt",
        plot="06_multiqc/multiqc_plots/png/fastqc_per_base_sequence_quality_plot.png",
    log:
        "logs/multiqc.log",
    shell:
        # --export also writes every plot as png/svg/pdf into 06_multiqc/multiqc_plots/
        "multiqc --force --export 01_fastqc_raw 03_fastqc_posttrim -o 06_multiqc > {log} 2>&1"


# -----------------------------------------------------------------------------
# 4. Reference indexes (BWA + samtools faidx)
# -----------------------------------------------------------------------------
rule bwa_index:
    input:
        REF,
    output:
        BWA_INDEX,
    log:
        "logs/bwa_index.log",
    shell:
        "bwa index {input} > {log} 2>&1"


rule samtools_faidx:
    input:
        REF,
    output:
        f"{REF}.fai",
    log:
        "logs/samtools_faidx.log",
    shell:
        "samtools faidx {input} 2> {log}"


# -----------------------------------------------------------------------------
# 5. Mapping (BWA-MEM), removal of unmapped reads (-F 4), sorting, indexing
# -----------------------------------------------------------------------------
rule map_sort:
    input:
        ref=REF,
        idx=BWA_INDEX,
        fq="02_trimmed/{sample}_posttrim.fastq",
    output:
        bam="04_bam/{sample}.sorted.bam",
        bai="04_bam/{sample}.sorted.bam.bai",
    params:
        rg=read_group,
    log:
        "logs/map_sort/{sample}.log",
    threads: THREADS
    shell:
        "(bwa mem -t {threads} -R '{params.rg}' {input.ref} {input.fq} "
        "| samtools view -b -F 4 - "
        "| samtools sort -@ {threads} -o {output.bam} -) 2> {log} "
        "&& samtools index {output.bam} 2>> {log}"


# -----------------------------------------------------------------------------
# 6. Duplicate removal (samtools rmdup, single-end mode) -- as in Galaxy "RmDup"
# -----------------------------------------------------------------------------
rule rmdup:
    input:
        bam="04_bam/{sample}.sorted.bam",
        bai="04_bam/{sample}.sorted.bam.bai",
    output:
        bam="04_bam/{sample}.nodup.bam",
        bai="04_bam/{sample}.nodup.bam.bai",
    log:
        "logs/rmdup/{sample}.log",
    shell:
        "samtools rmdup -s {input.bam} {output.bam} 2> {log} "
        "&& samtools index {output.bam} 2>> {log}"


# -----------------------------------------------------------------------------
# 7. Mapping quality control (Qualimap BamQC)
# -----------------------------------------------------------------------------
rule qualimap:
    input:
        bam="04_bam/{sample}.nodup.bam",
        bai="04_bam/{sample}.nodup.bam.bai",
    output:
        html="05_qualimap/{sample}/qualimapReport.html",
        txt="05_qualimap/{sample}/genome_results.txt",
        png=expand("05_qualimap/{{sample}}/images_qualimapReport/{plot}.png", plot=QUALIMAP_PLOTS),
    log:
        "logs/qualimap/{sample}.log",
    threads: THREADS
    shell:
        "qualimap bamqc -bam {input.bam} -outdir 05_qualimap/{wildcards.sample} "
        "-nt {threads} > {log} 2>&1"


# -----------------------------------------------------------------------------
# 8. Variant calling: FreeBayes, joint call on the 4 de-duplicated BAMs
# -----------------------------------------------------------------------------
rule freebayes:
    input:
        ref=REF,
        fai=f"{REF}.fai",
        bams=expand("04_bam/{sample}.nodup.bam", sample=SAMPLES),
        bais=expand("04_bam/{sample}.nodup.bam.bai", sample=SAMPLES),
    output:
        "07_vcf/all_samples.vcf",
    params:
        extra=config["freebayes"].get("extra", ""),
    log:
        "logs/freebayes.log",
    shell:
        "freebayes -f {input.ref} {params.extra} {input.bams} > {output} 2> {log}"


# -----------------------------------------------------------------------------
# 9. IGV view of the variants (igv-reports, by the IGV team): one HTML file with an
#    embedded igv.js browser showing reference, VCF and the 4 BAM pileups per variant
# -----------------------------------------------------------------------------
rule igv_report:
    input:
        vcf="07_vcf/all_samples.vcf",
        ref=REF,
        fai=f"{REF}.fai",
        bams=expand("04_bam/{sample}.nodup.bam", sample=SAMPLES),
        bais=expand("04_bam/{sample}.nodup.bam.bai", sample=SAMPLES),
    output:
        "09_igv/igv_report.html",
    params:
        flanking=100,
    log:
        "logs/igv_report.log",
    shell:
        "create_report {input.vcf} --fasta {input.ref} --flanking {params.flanking} "
        "--info-columns TYPE DP --sample-columns GT DP AD --standalone "
        "--title 'mtDNA variants - Blood/Cheek PCR1/PCR2' "
        "--tracks {input.vcf} {input.bams} --output {output} > {log} 2>&1"


# -----------------------------------------------------------------------------
# 10. Summary for the assignment (Python): tables from the MultiQC / Qualimap /
#     FreeBayes results + copies of the MultiQC and Qualimap figures
# -----------------------------------------------------------------------------
rule summary:
    input:
        multiqc_table="06_multiqc/multiqc_data/multiqc_fastqc.txt",
        multiqc_plot="06_multiqc/multiqc_plots/png/fastqc_per_base_sequence_quality_plot.png",
        qualimap=expand("05_qualimap/{sample}/genome_results.txt", sample=SAMPLES),
        qualimap_plots=expand(
            "05_qualimap/{sample}/images_qualimapReport/{plot}.png",
            sample=SAMPLES, plot=QUALIMAP_PLOTS,
        ),
        vcf="07_vcf/all_samples.vcf",
        igv="09_igv/igv_report.html",
    output:
        trimming="08_summary/q2_trimming_qc.csv",
        mapping="08_summary/q4_mapping_quality.csv",
        snps="08_summary/q5_snp_counts.csv",
        report="08_summary/summary.md",
        multiqc_plot="08_summary/figures/multiqc_fastqc_per_base_sequence_quality.png",
        qualimap_plots=expand(
            "08_summary/figures/qualimap_{sample}_{plot}.png",
            sample=SAMPLES, plot=QUALIMAP_PLOTS,
        ),
    params:
        samples=SAMPLES,
    log:
        "logs/summary.log",
    script:
        "scripts/summarize.py"
