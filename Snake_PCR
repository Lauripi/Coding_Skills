SAMPLES = ["Blood-PCR1", "Blood-PCR2", "Cheek-PCR1", "Cheek-PCR2"]

rule all:
    input:
        expand("qc/{sample}_fastqc.html", sample=SAMPLES)


rule fastqc:
    input:
        "raw/{sample}.fastq.gz"
    output:
        html="qc/{sample}_fastqc.html",
        zip="qc/{sample}_fastqc.zip"
    shell:
        "fastqc {input} -o qc/"